{
  "name": "taskking",
  "version": "1.2.0",
  "description": "Personal task management with King Task focus mode",
  "main": "src/main/index.js",
  "scripts": {
    "dev": "concurrently \"vite --config vite.config.mjs\" \"electron .\"",
    "build": "vite build --config vite.config.mjs && electron-builder",
    "build:win": "vite build --config vite.config.mjs && electron-builder --win",
    "build:mac": "vite build --config vite.config.mjs && electron-builder --mac",
    "build:linux": "vite build --config vite.config.mjs && electron-builder --linux",
    "vite:dev": "vite --config vite.config.mjs",
    "electron:dev": "electron ."
  },
  "author": "gritter",
  "license": "UNLICENSED",
  "private": true,
  "dependencies": {
    "dompurify": "^3.4.5",
    "express": "^4.21.0",
    "lucide-svelte": "^1.0.1",
    "marked": "^15.0.0",
    "sortablejs": "^1.15.6",
    "sql.js": "^1.11.0",
    "uuid": "^11.1.0"
  },
  "devDependencies": {
    "@electron/packager": "^20.0.0",
    "@sveltejs/vite-plugin-svelte": "^5.0.0",
    "concurrently": "^9.1.0",
    "electron": "^33.3.0",
    "electron-builder": "^25.1.0",
    "png-to-ico": "^3.0.1",
    "sharp": "^0.34.5",
    "svelte": "^5.0.0",
    "tailwindcss": "^4.0.0",
    "vite": "^6.0.0"
  }
}
